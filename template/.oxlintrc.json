{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "ignorePatterns": ["**/out/**", "**/dist/**", "**/coverage/**", "**/node_modules/**"],
  "rules": {
    "complexity": ["error", { "max": 6 }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2],
        "detectObjects": false,
        "ignoreDefaultValues": true,
        "ignoreNumericLiteralTypes": true
      }
    ]
  },
  "overrides": [
    {
      // Tests out of scope (settings, G05, G06): fixtures and expected values are literals by nature,
      // and a probe is allowed to be as branchy as the code it plants. The same list as TEST_FILES in
      // lint/test-scope.js (JSON cannot import it); test/test-scope.test.ts fails if the two differ.
      "files": ["**/*.test.*", "**/test/**"],
      "rules": { "no-magic-numbers": "off", "complexity": "off" }
    },
    {
      // The one assertion the template keeps: the IPC boundary hands the handler `raw` (unknown) and
      // the Zod schema (or none) decides its type, so `as In` is irreducible without changing
      // register's public signature (apps call it with a typed In and no schema). Exact path, this
      // rule only; test/oxlint-gate.test.ts pins the list to this file and no other.
      "files": ["src/main/ipc-router.ts"],
      "rules": { "typescript/consistent-type-assertions": "off" }
    }
  ]
}
