{
  "name": "appytron-app",
  "version": "0.1.0",
  "description": "An AppyTron desktop app (scaffold template).",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "David Cruwys",
  "license": "MIT",
  "scripts": {
    "postinstall": "node -e \"if (!process.env.ELECTRON_SKIP_BINARY_DOWNLOAD) { try { require('electron') } catch (e) { console.error('appytron: the Electron binary download failed. On CI, or offline, set ELECTRON_SKIP_BINARY_DOWNLOAD=1 to skip it.'); throw e } }\"",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "release:mac": "electron-vite build && electron-builder --mac --publish always",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "dup": "node lint/no-disable-directives.js && jscpd --config .jscpd.json && jscpd --config .jscpd.tests.json",
    "deadcode": "node lint/no-disable-directives.js && knip --no-config-hints && knip --production --exclude binaries && depcruise -c .dependency-cruiser.cjs --ts-config tsconfig.boundaries.json -T err-long src lint test vitest.config.ts eslint.config.js electron.vite.config.ts || node lint/deadcode-remedy.js",
    "lint": "node lint/no-disable-directives.js && oxlint --deny-warnings --format=default && eslint . --max-warnings 0",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@appydave/core": "^0.2.0",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "18.7.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "^17.14.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "oxlint": "~1.90.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
